CREATE OR REPLACE FUNCTION auditoria.fn_auditar_cambios()
RETURNS TRIGGER AS $$ BEGIN     IF (TG_OP = 'INSERT') THEN         INSERT INTO auditoria.cambios_clientes (momento, usuario_sesion, operacion, valores_antes, valores_despues)         VALUES (clock_timestamp(), current_user, 'INSERT', NULL, to_jsonb(NEW));         RETURN NEW;     ELSIF (TG_OP = 'UPDATE') THEN         INSERT INTO auditoria.cambios_clientes (momento, usuario_sesion, operacion, valores_antes, valores_despues)         VALUES (clock_timestamp(), current_user, 'UPDATE', to_jsonb(OLD), to_jsonb(NEW));         RETURN NEW;     ELSIF (TG_OP = 'DELETE') THEN         INSERT INTO auditoria.cambios_clientes (momento, usuario_sesion, operacion, valores_antes, valores_despues)         VALUES (clock_timestamp(), current_user, 'DELETE', to_jsonb(OLD), NULL);         RETURN OLD;     END IF;     RETURN NULL; END; $$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS trigger_auditoria_clientes ON clientes;

CREATE TRIGGER trigger_auditoria_clientes
AFTER INSERT OR UPDATE OR DELETE ON clientes
FOR EACH ROW
EXECUTE FUNCTION auditoria.fn_auditar_cambios();


